{$DOMAIN} {
    encode zstd gzip
    # WebSocket upgrades pass through reverse_proxy unchanged.
    reverse_proxy server:3010
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    tls {$ACME_EMAIL}
}
